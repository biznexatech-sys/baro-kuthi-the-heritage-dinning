{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/layout/call-bar/**",
              "components/layout/footer/**",
              "components/layout/header/**",
              "components/layout/invitation/**",
              "components/lib/**",
              "components/sections/course-scroll/**",
              "components/sections/guest-book/**",
              "components/sections/hero/**",
              "components/sections/info-strip/**",
              "components/sections/menu-book/**",
              "components/sections/occasions/**",
              "components/sections/reservation/**",
              "components/sections/rooms/**",
              "components/sections/story/**",
              "components/ui/actions/**",
              "components/ui/frames/**",
              "components/ui/type/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Cormorant Garamond|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Cormorant Garamond, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|shape|tone|width|height|loading|parallax|caption|className|style|key|ref|className|style|children)$/]",
        "message": "<ArchImage> doesn't accept that prop. Declared props: src, alt, shape, tone, width, height, loading, parallax, caption, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchImage'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:arch|tall|wide|cinema|square)$/]",
        "message": "<ArchImage> shape must be one of 'arch' | 'tall' | 'wide' | 'cinema' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchImage'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ArchImage> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchImage'] > JSXAttribute[name.name='loading'] > Literal[value!=/^(?:lazy|eager)$/]",
        "message": "<ArchImage> loading must be one of 'lazy' | 'eager'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|onClick|children|fullWidth|disabled|type|target|rel|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, onClick, children, fullWidth, disabled, type, target, rel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|on-dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Course'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|name|note|image|imageAlt|icon|key|ref|className|style|children)$/]",
        "message": "<Course> doesn't accept that prop. Declared props: numeral, name, note, image, imageAlt, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:motif|width|space|draw|className|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: motif, width, space, draw, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|numeral|tone|as|className|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, numeral, tone, as, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|terracotta)$/]",
        "message": "<Eyebrow> tone must be one of 'light' | 'dark' | 'terracotta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Row'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<Row> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='FrameDouble'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|fill|padding|children|className|style|key|ref|className|style|children)$/]",
        "message": "<FrameDouble> doesn't accept that prop. Declared props: as, fill, padding, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FrameDouble'] > JSXAttribute[name.name='fill'] > Literal[value!=/^(?:none|parchment|parchment-dark|terracotta-deep)$/]",
        "message": "<FrameDouble> fill must be one of 'none' | 'parchment' | 'parchment-dark' | 'terracotta-deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Review'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|quote|name|href|source|key|ref|className|style|children)$/]",
        "message": "<Review> doesn't accept that prop. Declared props: date, quote, name, href, source."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<LinkItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<LinkItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Phone'] > JSXAttribute > JSXIdentifier[name!=/^(?:display|href|key|ref|className|style|children)$/]",
        "message": "<Phone> doesn't accept that prop. Declared props: display, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='InvitationIntro'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onEnter|onSkip|storageKey|rememberDays|seal|shutter|position|className|style|key|ref|className|style|children)$/]",
        "message": "<InvitationIntro> doesn't accept that prop. Declared props: open, onEnter, onSkip, storageKey, rememberDays, seal, shutter, position, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InvitationIntro'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|absolute)$/]",
        "message": "<InvitationIntro> position must be one of 'fixed' | 'absolute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|price|description|speciality|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: id, name, price, description, speciality."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<LinkItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Phone'] > JSXAttribute > JSXIdentifier[name!=/^(?:display|href|key|ref|className|style|children)$/]",
        "message": "<Phone> doesn't accept that prop. Declared props: display, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<LinkItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rooms|layout|className|style|key|ref|className|style|children)$/]",
        "message": "<RoomRow> doesn't accept that prop. Declared props: rooms, layout, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomRow'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:auto|desktop|mobile)$/]",
        "message": "<RoomRow> layout must be one of 'auto' | 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|numeral|title|lead|tone|align|ornament|as|size|reveal|className|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, numeral, title, lead, tone, align, ornament, as, size, reveal, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|terracotta)$/]",
        "message": "<SectionHeading> tone must be one of 'light' | 'dark' | 'terracotta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:h2|h1|display)$/]",
        "message": "<SectionHeading> size must be one of 'h2' | 'h1' | 'display'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyCallBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:phoneHref|whatsappHref|callLabel|whatsappLabel|position|visibility|spacer|className|style|key|ref|className|style|children)$/]",
        "message": "<StickyCallBar> doesn't accept that prop. Declared props: phoneHref, whatsappHref, callLabel, whatsappLabel, position, visibility, spacer, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyCallBar'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:fixed|static)$/]",
        "message": "<StickyCallBar> position must be one of 'fixed' | 'static'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyCallBar'] > JSXAttribute[name.name='visibility'] > Literal[value!=/^(?:mobile|always)$/]",
        "message": "<StickyCallBar> visibility must be one of 'mobile' | 'always'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<LinkItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|children|arrow|tone|target|rel|className|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, onClick, children, arrow, tone, target, rel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<TextLink> tone must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
