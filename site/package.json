{
  "name": "baro-kuthi-heritage-dining",
  "version": "0.1.0",
  "private": true,
  "description": "BARO KUTHI RAJ BARI — The Heritage Dining production website (Next.js static export).",
  "scripts": {
    "sync:ds": "node scripts/sync-design-system.mjs",
    "predev": "npm run sync:ds && npm run icons && npm run dishes",
    "dev": "next dev",
    "prebuild": "npm run sync:ds && npm run icons && npm run dishes",
    "build": "next build",
    "start": "npx serve@latest out",
    "typecheck": "tsc --noEmit",
    "build:coming-soon": "node scripts/build-coming-soon.mjs",
    "preview:coming-soon": "node scripts/build-coming-soon.mjs && node scripts/serve-static.mjs out-coming-soon 4000",
    "icons": "node scripts/build-icons.mjs",
    "dishes": "node scripts/build-dishes.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource/noto-serif-bengali": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
