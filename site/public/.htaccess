# Hostinger (Apache) — served from public_html/ after uploading the contents of out/.
Options -Indexes
# Deploy bookkeeping written by GitHub Actions (FTP-Deploy-Action) — never served
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Browsers ask for /favicon.ico on their own — serve the generated PNG (source: images/favicon.svg)
  RewriteRule ^favicon\.ico$ /icons/favicon-48.png [L]
  # Folder-style URLs: /story → /story/ (matches trailingSlash: true in next.config.ts)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Hashed build assets (/_next/static) never change — cache for a year. HTML is revalidated on every visit.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fonts, images and the menu PDF — cache for 30 days. Pages link images with a content hash (?v=…, src/lib/asset.ts),
  # so a replaced image gets a new URL and every device fetches it at once.
  <FilesMatch "\.(woff2|webp|avif|jpg|jpeg|png|svg|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>
